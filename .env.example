# Labzyn server
LABZYN_PORT=4000
LABZYN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/labzyn?sslmode=disable

# HPC gateway (TAOUEY/Slurm) — réutilisé depuis deepsearch/gateway
LABZYN_GATEWAY_URL=http://localhost:8088

# Auth
LABZYN_JWT_SECRET=dev-insecure-secret-change-me

# Agent LLM (API compatible OpenAI : Groq, Mistral, OpenAI…)
# L'agent est désactivé tant qu'aucune clé n'est fournie.
LABZYN_LLM_BASE_URL=https://api.groq.com/openai/v1
LABZYN_LLM_API_KEY=
LABZYN_LLM_MODEL=llama-3.3-70b-versatile
